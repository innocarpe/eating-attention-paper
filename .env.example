# Canonical, origin-only HTTPS URLs. Production, preview, and RC must be pairwise distinct.
PUBLIC_PRODUCTION_ORIGIN=https://attention.example.org
PUBLIC_PREVIEW_ORIGIN=https://pr-123.attention-preview.example.org
PUBLIC_RC_ORIGIN=https://attention-rc.example.org

# Astro build target. Workflows set these for the exact deployment artifact.
SITE_URL=https://attention.example.org
BASE_PATH=/

# Analytics stays disabled in v1. There is intentionally no analytics endpoint or key.
