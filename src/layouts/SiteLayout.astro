---
import "../styles/global.css";
import "../components/widgets/widgets.css";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
}

const {
  title,
  description,
  canonical,
  image = "og.svg",
} = Astro.props;
const pageTitle = `${title} | Attention, 천천히 이해하기`;
const basePath = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const withBase = (path: string): string =>
  `${basePath}${path.replace(/^\/+/, "")}`;
const canonicalUrl = canonical
  ? new URL(canonical, Astro.url.origin).href
  : new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const imageUrl = new URL(withBase(image), Astro.site ?? Astro.url.origin).href;
---

<!doctype html>
<html lang="ko" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="referrer" content="no-referrer" />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content="Attention을 단계적으로 배우는 학습 사이트" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">본문으로 건너뛰기</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="wordmark" href={withBase("")} aria-label="Attention, 천천히 이해하기 홈">
          <span aria-hidden="true">A.</span> Attention
        </a>
        <nav aria-label="주요 탐색">
          <a href={withBase("curriculum")}>커리큘럼</a>
          <a href={withBase("learn")}>실습</a>
          <a href={`${withBase("")}#principles`}>원칙</a>
          <a href={withBase("about")}>소개</a>
        </nav>
      </div>
    </header>
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell footer-inner">
        <p>복잡한 개념을, 확인 가능한 작은 단계로.</p>
        <a href={`${withBase("about")}#open-source`}>오픈소스 범위</a>
      </div>
    </footer>
  </body>
</html>
