---
interface Props {
  eyebrow?: string;
}

const { eyebrow = "Attention을 읽는 연습" } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="shell hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">{eyebrow}</p>
      <h1 id="hero-title">0에서 100까지,<br />문장을 <em>살피는</em> 방법</h1>
      <p class="hero-lede">
        『Attention Is All You Need』를 수식 암기가 아니라, 왜 필요한지부터 작은 조작으로
        이해합니다. 홈에서 바로 학습을 시작하세요.
      </p>
      <div class="hero-actions" aria-label="학습 시작 안내">
        <a class="button button-primary" href="./study/">학습 시작</a>
        <a class="button button-secondary" href="./study/?lesson=why-attention">1번 레슨부터</a>
      </div>
    </div>
    <aside class="learning-card" aria-label="학습의 세 단계">
      <p class="card-label">LEARNING PATH</p>
      <ol>
        <li><span>01</span><strong>관찰</strong><p>어떤 단어를 볼지 묻습니다.</p></li>
        <li><span>02</span><strong>연결</strong><p>관계에 가중치를 붙입니다.</p></li>
        <li><span>03</span><strong>검증</strong><p>결과를 다시 말로 확인합니다.</p></li>
      </ol>
      <p class="card-note">각 단계는 짧고, 되돌아갈 수 있어야 합니다.</p>
    </aside>
  </div>
</section>
