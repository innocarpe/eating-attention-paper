---
import Hero from "../components/Hero.astro";
import SiteLayout from "../layouts/SiteLayout.astro";

const coreTopics = [
  "문제를 푸는 방식과 임베딩",
  "어텐션 직관과 가중합",
  "Scaled Dot-Product Attention",
  "Multi-Head Attention",
  "위치 인코딩",
  "인코더와 디코더",
  "학습 목표와 최적화",
  "논문 결과와 한계 비판",
];
---

<SiteLayout
  title="0→100 학습 경로"
  description="『Attention Is All You Need』를 직관, 수학, 구현, 비판의 순서로 배우고 스스로 이해를 검증하는 한국어 우선 오픈소스 학습 프로젝트"
>
  <Hero />

  <section id="start" class="content-section" aria-labelledby="start-title">
    <div class="shell prose">
      <p class="eyebrow">START WITH THE PAPER PATH</p>
      <h2 id="start-title">지금 바로 논문 0→100 학습을 시작하세요</h2>
      <p>
        이 프로젝트의 본체는 인프라 데모가 아니라, 초보자가 Attention 핵심 개념을 순서대로
        이해하고 직접 조작·퀴즈로 확인하는 학습 경로입니다.
      </p>
      <p>
        <a class="button button-primary" href="./study/">학습 시작 (Study)</a>
        <a class="button button-secondary" href="./curriculum/">전체 커리큘럼 지도</a>
      </p>
    </div>
  </section>

  <section id="curriculum" class="content-section surface-muted" aria-labelledby="curriculum-title">
    <div class="shell prose">
      <p class="eyebrow">CORE PATH</p>
      <h2 id="curriculum-title">핵심 개념부터 차근차근</h2>
      <p>
        아래 순서는 논문 목차를 그대로 외우는 순서가 아닙니다. “왜 필요한지”를 먼저 잡고
        Scaled Dot-Product, Multi-Head, 위치 인코딩, Encoder/Decoder로 올라갑니다.
      </p>
      <ol class="topic-grid">
        {coreTopics.map((topic, index) => (
          <li><span>{String(index + 1).padStart(2, "0")}</span>{topic}</li>
        ))}
      </ol>
      <p>
        인터랙티브 레슨: <a href="./study/">/study</a> ·
        모듈 상세: <a href="./curriculum/">/curriculum</a> ·
        코드 실험: <a href="./sandbox/">/sandbox</a>
      </p>
    </div>
  </section>

  <section id="principles" class="content-section" aria-labelledby="principles-title">
    <div class="shell prose">
      <p class="eyebrow">HOW YOU LEARN</p>
      <h2 id="principles-title">읽고, 조작하고, 설명해야 넘어갑니다</h2>
      <ul class="principle-list">
        <li><strong>초보자 우선:</strong> 용어 전에 문제 상황을 한국어로 먼저 설명합니다.</li>
        <li><strong>작은 계산:</strong> 큰 행렬 대신 손으로 가능한 숫자로 확인합니다.</li>
        <li><strong>직접 조작:</strong> Query를 바꿔 attention 가중치 변화를 봅니다.</li>
        <li><strong>이해 확인:</strong> 각 레슨 끝 퀴즈로 “대충 본 것”과 구분합니다.</li>
        <li><strong>로컬 우선:</strong> 진도는 이 브라우저에만 저장됩니다.</li>
      </ul>
    </div>
  </section>

  <section id="open-source" class="content-section surface-muted" aria-labelledby="open-source-title">
    <div class="shell prose">
      <p class="eyebrow">OPEN SOURCE</p>
      <h2 id="open-source-title">내가 이해한 방식으로, 다른 초보자도 이해하게</h2>
      <p>
        Apache-2.0 공개 학습 자료입니다. 아직 사람 검증/출시 승인을 끝냈다고 주장하지 않습니다.
        대신 실제로 공부 가능한 경로를 계속 두껍게 만듭니다.
      </p>
      <p>
        <a class="button button-primary" href="./study/">학습 시작</a>
        <a class="button button-secondary" href="./about">프로젝트 소개</a>
      </p>
    </div>
  </section>
</SiteLayout>

<style>
  .topic-grid,
  .principle-list {
    display: grid;
    gap: 0.85rem;
    margin: 2rem 0;
    padding: 0;
    list-style: none;
  }

  .topic-grid {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
  }

  .topic-grid li,
  .principle-list li {
    padding: 1rem 1.1rem;
    border: 1px solid var(--line);
    background: var(--paper);
  }

  .topic-grid span {
    display: block;
    margin-bottom: 0.35rem;
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  .principle-list strong {
    color: var(--accent-strong);
  }
</style>
