---
import Hero from "../components/Hero.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { getOrderedLessons } from "../lessons/path";

const lessons = getOrderedLessons();
const totalMinutes = lessons.reduce((sum, lesson) => sum + lesson.minutes, 0);
---

<SiteLayout
  title="0→100 학습 경로"
  description="『Attention Is All You Need』를 직관, 수학, 작은 조작, 퀴즈 순서로 초보자가 차근차근 이해하도록 돕는 한국어 우선 오픈소스 학습 사이트"
>
  <Hero />

  <section id="start" class="content-section" aria-labelledby="start-title">
    <div class="shell prose">
      <p class="eyebrow">START HERE</p>
      <h2 id="start-title">홈에서 바로 논문 0→100 학습으로 들어가세요</h2>
      <p>
        이 사이트의 본체는 인프라 데모가 아닙니다. 똑똑하지 않아도 따라올 수 있게,
        핵심 개념 → 작은 계산 → 직접 조작 → 퀴즈 확인 순서로 『Attention Is All You Need』를
        공부합니다. 예상 {totalMinutes}분 · 레슨 {lessons.length}개.
      </p>
      <p class="home-actions">
        <a class="button button-primary" href="./study/">지금 학습 시작</a>
        <a class="button button-secondary" href="./study/?lesson=dot-product-attention">
          Attention 계산부터
        </a>
        <a class="button button-secondary" href="./curriculum/">전체 지도</a>
      </p>
    </div>
  </section>

  <section id="curriculum" class="content-section surface-muted" aria-labelledby="curriculum-title">
    <div class="shell prose">
      <p class="eyebrow">CLICK A LESSON</p>
      <h2 id="curriculum-title">핵심 레슨으로 바로 이동</h2>
      <p>
        카드를 누르면 해당 레슨이 열립니다. 처음이면 1번부터, 관심 있는 개념이 있으면 그 카드부터
        들어가도 됩니다.
      </p>
      <ol class="topic-grid">
        {
          lessons.map((lesson) => (
            <li>
              <a class="topic-card" href={`./study/?lesson=${lesson.id}`}>
                <span>{String(lesson.order).padStart(2, "0")}</span>
                <strong>{lesson.title}</strong>
                <em>{lesson.englishTerm}</em>
                <small>{lesson.minutes}분 · {lesson.summary}</small>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="map" class="content-section" aria-labelledby="map-title">
    <div class="shell prose">
      <p class="eyebrow">WHERE TO GO</p>
      <h2 id="map-title">헷갈리지 않게, 역할만 나눴습니다</h2>
      <ul class="principle-list">
        <li>
          <strong>학습 본편:</strong>
          <a href="./study/">/study</a> — 설명 + 인터랙티브 + 퀴즈
        </li>
        <li>
          <strong>커리큘럼 지도:</strong>
          <a href="./curriculum/">/curriculum</a> — 전체 모듈 목록
        </li>
        <li>
          <strong>코드 실험:</strong>
          <a href="./sandbox/">/sandbox</a> — 제한된 Python 실행
        </li>
        <li>
          <strong>출시 상태:</strong>
          <a href="./release/">/release</a> — 무엇이 됐고 무엇이 아직인지
        </li>
      </ul>
      <p class="home-actions">
        <a class="button button-primary" href="./study/">학습 시작</a>
        <a class="button button-secondary" href="./about">프로젝트 소개</a>
      </p>
    </div>
  </section>
</SiteLayout>

<style>
  .home-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .topic-grid,
  .principle-list {
    display: grid;
    gap: 0.85rem;
    margin: 2rem 0;
    padding: 0;
    list-style: none;
  }

  .topic-grid {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }

  .topic-card,
  .principle-list li {
    display: grid;
    gap: 0.35rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--line);
    background: var(--paper);
    color: inherit;
    text-decoration: none;
  }

  .topic-card:hover,
  .topic-card:focus-visible {
    border-color: var(--accent);
    background: var(--accent-pale);
  }

  .topic-card span {
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  .topic-card em,
  .topic-card small {
    color: var(--muted);
    font-style: normal;
  }

  .principle-list strong {
    color: var(--accent-strong);
  }
</style>
